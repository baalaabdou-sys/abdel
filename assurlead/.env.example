# ══════════════════════════════════════════════════════════════
# ASSURLEAD AI — variables d'environnement
# Copiez ce fichier en `.env` et renseignez les valeurs.
# ══════════════════════════════════════════════════════════════

# ── OBLIGATOIRE ───────────────────────────────────────────────

# Base de données PostgreSQL 14+.
DATABASE_URL="postgresql://user:password@localhost:5432/assurlead?schema=public"

# Secret de signature des sessions. 32 caractères aléatoires minimum.
# Générer : openssl rand -base64 32
AUTH_SECRET=""

# Clé de chiffrement des identifiants fournisseurs stockés en base (AES-256-GCM).
# Générer : openssl rand -base64 32
# ⚠️ La changer rend illisibles les identifiants déjà enregistrés.
ENCRYPTION_KEY=""

# URL publique de l'application. Utilisée pour les liens de suivi, les landing
# pages et les URL de webhook. Sans barre oblique finale.
APP_URL="http://localhost:3000"


# ── FOURNISSEUR D'ENVOI D'EMAILS ──────────────────────────────
# Chaque compte d'envoi est configuré dans l'interface (« Comptes Email »), avec
# des identifiants chiffrés en base. Ces variables ne servent que de repli.
#
# Valeurs possibles : demo | smtp | brevo | mailgun | ses | postmark
# « demo » n'envoie AUCUN email réel : le parcours complet est exerçable
# (file d'envoi, liens de suivi, landing page, création de leads) sans clé.
EMAIL_PROVIDER="demo"


# ── VÉRIFICATION DES ADRESSES EMAIL ───────────────────────────
# Valeurs possibles : local | demo | zerobounce | neverbounce | hunter
#   local  : syntaxe + domaines jetables + résolution MX réelle (aucune clé).
#            Ne teste pas l'existence de la boîte : le meilleur résultat
#            possible est « probablement valide ».
#   demo   : hors ligne et déterministe, sans aucun appel réseau.
VERIFICATION_PROVIDER="local"
ZEROBOUNCE_API_KEY=""
NEVERBOUNCE_API_KEY=""
HUNTER_API_KEY=""


# ── INTELLIGENCE ARTIFICIELLE ─────────────────────────────────
# Valeurs possibles : demo | anthropic | openai
# « demo » est un générateur déterministe à base de règles, PAS un modèle de
# langage. Ses réponses sont toujours signalées comme simulées dans l'interface.
AI_PROVIDER="demo"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Plafond mensuel de requêtes IA par espace de travail. Protège contre les
# boucles accidentelles et les dépenses imprévues.
AI_MONTHLY_REQUEST_CAP="5000"


# ── WORKER DE TÂCHES DE FOND ──────────────────────────────────
# Le worker (`npm run worker`) traite la file d'envoi, la vérification des
# adresses, les imports volumineux et les alertes de délai de traitement.
WORKER_POLL_MS="2000"
WORKER_BATCH="10"


# ── STOCKAGE DES FICHIERS IMPORTÉS ────────────────────────────
# Répertoire où les fichiers CSV/XLSX sont déposés le temps de l'import.
# Doit être accessible en écriture et partagé entre le web et le worker.
UPLOAD_DIR=".uploads"


# ── OPTIONNEL ─────────────────────────────────────────────────

# Redis — non requis. La file d'attente utilise PostgreSQL (voir README).
# Renseigner uniquement si vous mettez en place un cache ou une limitation
# de débit partagée entre plusieurs instances.
REDIS_URL=""

# En production, Next.js fournit VERCEL_URL automatiquement sur Vercel ;
# APP_URL reste prioritaire si elle est définie.
