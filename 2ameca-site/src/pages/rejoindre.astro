---
import Base from '../layouts/Base.astro';
import EnTetePage from '../components/EnTetePage.astro';
import Lignes from '../components/Lignes.astro';
import { INSCRIPTION_URL } from '../config';

const raisons = [
  { titre: 'Pratiquer', texte: 'Passer des cours à la réalisation : concevoir, modéliser, fabriquer et tester en équipe.' },
  { titre: 'Apprendre', texte: 'Des formations et des ateliers pour découvrir de nouveaux outils, à votre rythme, avec des étudiants plus avancés.' },
  { titre: 'Rencontrer', texte: 'Des étudiants d’autres filières, d’autres clubs et des professionnels lors de nos événements.' },
  { titre: 'S’engager', texte: 'Organiser, communiquer, porter un projet : des compétences utiles bien au-delà de la mécanique.' },
];

const etapes = [
  { titre: 'Remplissez le formulaire', texte: 'Quelques questions sur vous, votre filière et ce qui vous intéresse. Deux minutes suffisent.' },
  { titre: 'Le bureau vous recontacte', texte: 'Un membre du bureau revient vers vous pour vous présenter le club et les prochaines activités.' },
  { titre: 'Participez', texte: 'Rejoignez un projet, une formation ou l’organisation d’un événement, selon vos envies.' },
];
---
<Base titre="Rejoindre le club" description="Rejoignez le Club 2AMECA à la FSAC : aucune expérience en mécanique n’est demandée. Inscription en ligne en deux minutes.">
  <EnTetePage
    surtitre="Adhésion 2026–2027"
    titre="Rejoindre 2AMECA"
    chapo="Aucune expérience en mécanique n’est demandée. Si vous êtes curieux et motivé, il y a une place pour vous dans l’atelier."
  >
    <div class="boutons haut">
      <a class="btn btn-clair" href={INSCRIPTION_URL} target="_blank" rel="noopener">
        S’inscrire maintenant <span class="fleche" aria-hidden="true">↗</span><span class="sr-only"> (formulaire Google, nouvel onglet)</span>
      </a>
    </div>
  </EnTetePage>

  <section class="section" aria-labelledby="pourquoi">
    <div class="conteneur">
      <span class="surtitre reveal">Pourquoi nous rejoindre</span>
      <h2 id="pourquoi" class="titre-2 reveal">Quatre bonnes raisons</h2>
      <hr class="trait" />
      <ul class="raisons grille" role="list">
        {raisons.map((r) => (
          <li class="reveal">
            <h3 class="titre-3">{r.titre}</h3>
            <p>{r.texte}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section tres-sombre serree" aria-labelledby="qui">
    <Lignes variante="haut-droite" />
    <div class="conteneur qui reveal">
      <div>
        <span class="surtitre">Qui peut nous rejoindre</span>
        <h2 id="qui" class="titre-2">Toutes les filières, tous les niveaux</h2>
      </div>
      <ul class="conditions" role="list">
        <li><strong>Étudiant(e) à la FSAC</strong>, quelle que soit votre filière : physique, maths, informatique, chimie, biologie…</li>
        <li><strong>De la 1re année au doctorat.</strong> Les nouveaux étudiants sont particulièrement bienvenus.</li>
        <li><strong>Aucune expérience en mécanique</strong> n’est nécessaire : on apprend ensemble, sur le terrain.</li>
      </ul>
    </div>
  </section>

  <section class="section" id="inscription" aria-labelledby="form-titre">
    <div class="conteneur mise-form">
      <div class="reveal">
        <span class="surtitre">Inscription</span>
        <h2 id="form-titre" class="titre-2">Comment ça marche</h2>
        <hr class="trait" />
        <ol class="etapes" role="list">
          {etapes.map((e, i) => (
            <li>
              <span class="num" aria-hidden="true">{i + 1}</span>
              <div>
                <h3 class="titre-3">{e.titre}</h3>
                <p>{e.texte}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="carte-form reveal">
        <span class="label">Formulaire d’adhésion</span>
        <p class="carte-titre">Inscription au Club 2AMECA</p>
        <p class="carte-texte">Le formulaire s’ouvre dans Google Forms, dans un nouvel onglet.</p>
        <a class="btn btn-clair grand" href={INSCRIPTION_URL} target="_blank" rel="noopener">
          Ouvrir le formulaire <span class="fleche" aria-hidden="true">↗</span><span class="sr-only"> (nouvel onglet)</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .haut { margin-top: 1.75rem; }

  .raisons { list-style: none; padding: 0; }
  @media (min-width: 640px) { .raisons { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .raisons { grid-template-columns: repeat(4, 1fr); } }
  .raisons li { border-top: 2px solid var(--bleu); padding-top: 1.1rem; }
  .raisons .titre-3 { color: var(--marine); margin: 0 0 .5rem; }
  .raisons p { color: var(--encre-70); margin: 0; }

  .qui { display: grid; gap: 2rem 4rem; }
  @media (min-width: 900px) { .qui { grid-template-columns: 1fr 1.1fr; align-items: center; } }
  .conditions { list-style: none; padding: 0; display: grid; }
  .conditions li { padding: 1rem 0 1rem 2rem; border-top: 1px solid var(--ciel-18); position: relative; color: var(--blanc-70); }
  .conditions li::before { content: ''; position: absolute; left: 0; top: 1.55rem; width: 1rem; height: 1.5px; background: var(--ciel); }
  .conditions strong { color: var(--blanc); font-weight: 600; }

  .mise-form { display: grid; gap: 2.5rem; }
  @media (min-width: 980px) { .mise-form { grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; } }

  /* Les étapes forment une vraie séquence : la numérotation est justifiée. */
  .etapes { list-style: none; padding: 0; display: grid; gap: 1.5rem; }
  .etapes li { display: grid; grid-template-columns: 2.6rem 1fr; gap: 1rem; align-items: start; }
  .etapes .num {
    display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%;
    border: 1.5px solid var(--bleu); color: var(--bleu); font-family: var(--f-titre); font-size: 1.2rem;
  }
  .etapes .titre-3 { color: var(--marine); font-size: 1.15rem; margin: .35rem 0 .3rem; }
  .etapes p { margin: 0; color: var(--encre-70); }

  .carte-form {
    position: relative; overflow: hidden;
    background: var(--bleu); color: var(--blanc);
    border-radius: var(--rayon); padding: clamp(1.5rem, 5vw, 2.5rem);
    display: grid; gap: .75rem; justify-items: start;
  }
  .carte-form .label { color: var(--ciel); letter-spacing: .24em; font-size: .72rem; }
  .carte-titre { font-family: var(--f-titre); text-transform: uppercase; font-size: clamp(1.8rem, 6vw, 2.6rem); line-height: 1; margin: 0; }
  .carte-texte { color: var(--blanc-70); margin: 0 0 .75rem; }
  .grand { min-height: 56px; padding-inline: 1.8em; font-size: 1rem; }
  @media (max-width: 519px) { .grand { width: 100%; } }
</style>
