---
import Base from '../layouts/Base.astro';
import EnTetePage from '../components/EnTetePage.astro';
import Emplacement from '../components/Emplacement.astro';
import Fsac from '../components/Fsac.astro';
import Lignes from '../components/Lignes.astro';
import AppelRejoindre from '../components/AppelRejoindre.astro';
import bureau from '../data/bureau.json';
import { FSAC } from '../config';
import { CLUB_DEFAUT } from '../data/contenus';
import { u } from '../lib/url';

const { etapes: historique, valeurs, histoire, mission, intro } = CLUB_DEFAUT;
const crochets = (t: string) => /^\s*\[.*\]\s*$/s.test(t);
---
<Base titre="Le club" description="2AMECA, Atelier d’Application Mécanique et Esprit au Citoyen : club estudiantin de la FSAC. Histoire, mission, valeurs et bureau.">
  <EnTetePage
    surtitre="Le club"
    titre="2AMECA"
    chapo="Atelier d’Application Mécanique et Esprit au Citoyen. La science, l’innovation et l’engagement au service des étudiants."
  >
    <p slot="script" class="script devise" aria-hidden="true">Esprit citoyen au centre</p>
  </EnTetePage>

  <!-- Présentation -->
  <section class="section serree" aria-labelledby="presentation">
    <div class="conteneur presentation reveal">
      <span class="surtitre">Le club</span>
      <h2 id="presentation" class="titre-2">Atelier d’Application Mécanique et Esprit au Citoyen</h2>
      <hr class="trait" />
      <div class="presentation-texte" data-c="intro">
        {intro.split(/\n\s*\n/).map((t) => <p class="chapo">{t}</p>)}
      </div>
    </div>
  </section>

  <!-- Histoire -->
  <section class="section" aria-labelledby="histoire">
    <Lignes variante="haut-droite" />
    <div class="conteneur deux-col">
      <div class="reveal">
        <span class="surtitre">Histoire</span>
        <h2 id="histoire" class="titre-2">D’où vient 2AMECA</h2>
        <hr class="trait" />
        <div class="histoire-texte" data-c="histoire">
          {histoire.split(/\n\s*\n/).map((t) => <p>{crochets(t) ? <span class="a-fournir">{t}</span> : t}</p>)}
        </div>
      </div>
      <ol class="frise" role="list" data-c="etapes">
        {historique.map((h) => (
          <li class="reveal">
            <span class="label quand">{h.quand.startsWith('[') ? <span class="a-fournir">{h.quand}</span> : h.quand}</span>
            <p class="quoi">{h.quoi}</p>
            <p class="detail">{h.detail.startsWith('[') ? <span class="a-fournir">{h.detail}</span> : h.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Mission -->
  <section class="section tres-sombre" aria-labelledby="mission">
    <Lignes variante="bas-gauche" />
    <div class="conteneur mission reveal">
      <span class="surtitre">Mission</span>
      <h2 id="mission" class="titre-1">Relier la théorie, la pratique et le monde professionnel</h2>
      <div class="mission-texte" data-c="mission">
        {mission.split(/\n\s*\n/).map((t) => <p class="chapo">{crochets(t) ? <span class="a-fournir">{t}</span> : t}</p>)}
      </div>
    </div>
  </section>

  <!-- Valeurs -->
  <section class="section" aria-labelledby="valeurs">
    <div class="conteneur">
      <div class="entete-section reveal">
        <div>
          <span class="surtitre">Valeurs</span>
          <h2 id="valeurs" class="titre-2">Ce qui nous guide</h2>
        </div>
      </div>
      <ul class="valeurs grille" role="list" data-c="valeurs">
        {valeurs.map((v, i) => (
          <li class="reveal">
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="titre-3">{v.titre}</h3>
            <p>{v.texte}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bureau -->
  <section class="section teinte" aria-labelledby="bureau">
    <div class="conteneur">
      <div class="entete-section reveal">
        <div>
          <span class="surtitre">Le bureau {`2026–2027`}</span>
          <h2 id="bureau" class="titre-2">L’équipe</h2>
        </div>
        <p class="note">Les membres du bureau organisent les activités du club et accueillent les nouveaux.</p>
      </div>
      <ul class="equipe" role="list" data-c="bureau">
        {bureau.map((m) => (
          <li class="membre reveal">
            {m.photo ? (
              <img src={u(m.photo)} alt={`Portrait de ${m.nom}`} width="480" height="600" loading="lazy" decoding="async" />
            ) : (
              <Emplacement texte="[Photo]" ratio="4 / 5" />
            )}
            <div class="membre-texte">
              <p class="nom">{m.nom.startsWith('[') ? <span class="a-fournir">{m.nom}</span> : m.nom}</p>
              <p class="role label">{m.role}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Partenaires (gérés depuis le tableau de bord) -->
  <section class="section teinte serree" aria-labelledby="partenaires" id="bloc-partenaires" hidden>
    <div class="conteneur">
      <span class="surtitre">Ils nous soutiennent</span>
      <h2 id="partenaires" class="titre-2">Nos partenaires</h2>
      <hr class="trait" />
      <ul class="partenaires" id="liste-partenaires" role="list"></ul>
    </div>
  </section>

  <!-- FSAC -->
  <section class="section serree" aria-labelledby="fsac">
    <div class="conteneur fsac reveal">
      <Fsac taille="grande" lien />
      <div>
        <span class="surtitre">Notre faculté</span>
        <h2 id="fsac" class="titre-3">{FSAC.nom}</h2>
        <p>2AMECA est un club étudiant de la {FSAC.nom}, établissement de l’{FSAC.universite}.</p>
        <a class="lien-fleche" href={FSAC.url} rel="noopener" target="_blank">
          Site de la FSAC <span aria-hidden="true">↗</span><span class="sr-only"> (nouvel onglet)</span>
        </a>
      </div>
    </div>
  </section>

  <AppelRejoindre />
</Base>

<style>
  .devise { font-size: clamp(2.6rem, 10vw, 4.5rem); margin: .4rem 0 0; transform: rotate(-3deg); transform-origin: left; }

  .presentation .titre-2 { max-width: 22ch; }
  .presentation-texte { display: grid; gap: 0 3rem; margin-top: 1.5rem; }
  @media (min-width: 900px) { .presentation-texte { grid-template-columns: 1fr 1fr; } }
  .deux-col { display: grid; gap: 2.5rem 4rem; }
  @media (min-width: 900px) { .deux-col { grid-template-columns: 1fr 1fr; } }

  .frise { list-style: none; padding: 0 0 0 1.5rem; border-left: 1.5px solid var(--bleu); display: grid; gap: 2rem; }
  .frise li { position: relative; }
  .frise li::before {
    content: ''; position: absolute; left: calc(-1.5rem - 6px); top: .35rem;
    width: 11px; height: 11px; border-radius: 50%; background: var(--blanc); border: 2px solid var(--bleu);
  }
  .quand { color: var(--bleu); }
  .quoi { font-family: var(--f-label); font-weight: 500; font-size: 1.2rem; color: var(--marine); text-transform: uppercase; line-height: 1.25; margin: .3rem 0 .3rem; }
  .detail { margin: 0; color: var(--encre-70); }

  .mission .titre-1 { max-width: 18ch; }
  .mission-texte { margin-top: 2rem; display: grid; gap: 0 3rem; }
  @media (min-width: 900px) { .mission-texte { grid-template-columns: 1fr 1fr; } }

  .valeurs { list-style: none; padding: 0; }
  @media (min-width: 640px) { .valeurs { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .valeurs { grid-template-columns: repeat(4, 1fr); } }
  .valeurs li { border-top: 2px solid var(--bleu); padding-top: 1.1rem; }
  .valeurs .num { font-family: var(--f-titre); color: var(--bleu); font-size: 1.1rem; }
  .valeurs .titre-3 { color: var(--marine); margin: .5rem 0 .5rem; }
  .valeurs p { color: var(--encre-70); margin: 0; }

  .note { max-width: 26rem; color: var(--encre-70); margin: 0; }
  .equipe { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 720px) { .equipe { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; } }
  @media (min-width: 1100px) { .equipe { grid-template-columns: repeat(6, 1fr); } }
  .membre { background: var(--blanc); border-radius: var(--rayon); overflow: hidden; border: 1px solid var(--bleu-12); }
  .membre img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .membre :global(.emplacement) { border: 0; border-bottom: 1px solid var(--bleu-12); }
  .membre-texte { padding: .8rem .9rem 1rem; }
  .nom { font-family: var(--f-label); font-weight: 500; font-size: 1.02rem; color: var(--marine); margin: 0 0 .2rem; line-height: 1.25; }
  .role { color: var(--bleu); margin: 0; font-size: .7rem; letter-spacing: .1em; }

  .fsac { display: grid; gap: 1.5rem 3rem; align-items: center; }
  @media (min-width: 720px) { .fsac { grid-template-columns: auto 1fr; } }
  .fsac .titre-3 { color: var(--marine); margin-bottom: .6rem; }
</style>

<style is:global>
  /* ── Cartes du bureau : une scène animée par rôle, façon plan technique ── */
  .photo-bouton { position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; overflow: hidden; container-type: inline-size; }
  .photo-bouton:focus-visible { outline: 3px solid var(--ciel); outline-offset: -3px; }
  .photo-bouton img { display: block; transition: transform .7s, filter .7s; }
  .photo-bouton.joue img { transform: scale(1.06); filter: grayscale(.4) brightness(.92); }
  .scene {
    --d: 4.4s;
    position: absolute; inset: 0; opacity: 0; pointer-events: none; color: var(--ciel);
    background:
      repeating-linear-gradient(0deg, rgb(159 208 245 / .11) 0 1px, transparent 1px 18px),
      repeating-linear-gradient(90deg, rgb(159 208 245 / .11) 0 1px, transparent 1px 18px),
      radial-gradient(120% 90% at 50% 40%, rgb(4 34 58 / .30), rgb(4 34 58 / .72));
  }
  .scene svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .scene-lignes line { stroke: var(--ciel); stroke-width: 1; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: .7; }
  .scene-dessin { fill: none; stroke: var(--ciel); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .scene-dessin .fin { stroke-width: 1; } .scene-dessin .gras { stroke-width: 2.4; stroke: var(--blanc); }
  .scene-dessin .past { fill: rgb(4 34 58 / .92); stroke: var(--ciel); stroke-width: 1.4; }
  .scene-dessin .plein { fill: var(--ciel); stroke: none; }
  .scene-dessin .ic { stroke: var(--blanc); stroke-width: 1.7; }
  .scene-dessin .plein-ic path { fill: var(--ciel); stroke: var(--ciel); }
  .scene-dessin .pointille { stroke-dasharray: 2 5; } .scene-dessin .pointille2 { stroke-dasharray: 5 5; }
  .scene-dessin .axe { stroke-dasharray: 12 4 2 4; opacity: .7; }
  .scene-dessin .txt { fill: var(--blanc); stroke: none; font-family: var(--f-label); font-weight: 500; font-size: 10px; letter-spacing: .14em; }
  .scene-dessin .txt.petit { font-size: 6.5px; fill: var(--ciel); }
  .scene-dessin .nuance { stroke: var(--ciel); stroke-width: 1.2; }
  .scene-dessin .pinceau { stroke: var(--ciel); stroke-width: 20; opacity: .5; }
  .scene-dessin .tr { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .scene-dessin .pp, .scene-dessin .droit, .scene-dessin .tampon, .scene-dessin .vol, .scene-dessin .balle-r, .scene-dessin .focus, .scene-dessin .pulse { transform-box: fill-box; transform-origin: center; }
  .scene-dessin .flash { fill: var(--blanc); stroke: none; opacity: 0; }
  .scene-dessin .focus { stroke: var(--blanc); stroke-width: 1.4; opacity: 0; }
  .scene-dessin .onde { opacity: 0; stroke-width: 2; }
  .scene-dessin .onde-tampon { opacity: 0; transform-box: fill-box; transform-origin: center; }
  .scene-dessin .tampon { opacity: 0; } .scene-dessin .plein-tampon { fill: var(--bleu); stroke: var(--blanc); stroke-width: 2; }
  .scene-dessin .aig { stroke: var(--blanc); stroke-width: 2; }
  .scene-role {
    position: absolute; left: 0; right: 0; bottom: 5.5%; text-align: center; padding: 0 .4rem;
    font-family: var(--f-label); font-weight: 500; font-size: clamp(.6rem, 6.2cqw, .9rem); letter-spacing: .22em; text-transform: uppercase; color: var(--blanc);
  }
  .scene-role::before { content: ''; display: block; width: 2.2em; height: 1px; background: var(--ciel); margin: 0 auto .45em; }

  .joue .scene { animation: sc-voile var(--d) ease forwards; }
  .joue .scene-lignes line { animation: sc-trace 1s cubic-bezier(.3,.7,.3,1) forwards; }
  .joue .scene-lignes line:nth-child(2) { animation-delay: .1s; } .joue .scene-lignes line:nth-child(3) { animation-delay: .2s; } .joue .scene-lignes line:nth-child(4) { animation-delay: .3s; }
  .joue .scene-role { animation: sc-monte .6s .3s ease backwards; }
  .joue .tr { animation: sc-trace var(--du, .8s) var(--t, 0s) cubic-bezier(.4,.1,.3,1) forwards; }
  .joue .pp { animation: sc-pop .5s var(--t, 0s) cubic-bezier(.3,1.6,.5,1) backwards; }
  .joue .fd { animation: sc-fondu .6s var(--t, 0s) ease backwards; }
  .joue .gl { animation: sc-glisse .7s var(--t, 0s) cubic-bezier(.2,.9,.3,1) backwards; }
  .joue .up { animation: sc-envol var(--du, 1.8s) var(--t, 0s) ease-out both; }
  .joue .pulse { animation: sc-pop .5s var(--t, 0s) cubic-bezier(.3,1.6,.5,1) backwards, sc-pulse 1.2s calc(var(--t, 0s) + .6s) ease-in-out 2; }
  .joue .orb { transform-origin: 100px 102px; animation: sc-tour 3.8s .2s cubic-bezier(.45,.05,.35,1) forwards; }
  .joue .droit { animation: sc-tour-inverse 3.8s .2s cubic-bezier(.45,.05,.35,1) forwards; }
  .joue .flash { animation: sc-flash .5s 1.6s ease-out; }
  .joue .focus { animation: sc-focus 1.5s .5s cubic-bezier(.2,.8,.3,1) forwards; }
  .joue .rec { animation: sc-clignote .7s .3s steps(2, jump-none) 5; }
  .joue .onde { animation: sc-onde 1.5s var(--t, 0s) ease-out 2; }
  .joue .aig { animation: sc-tour-simple 2.6s .3s cubic-bezier(.4,0,.2,1) forwards; }
  .joue .aig.lente { animation: sc-tour-quart 2.6s .3s cubic-bezier(.4,0,.2,1) forwards; }
  .joue .stylo-ecrit { animation: sc-ecrit var(--du) var(--t) cubic-bezier(.4,.1,.3,1) both; }
  .joue .vol { animation: sc-pop .5s 1.7s cubic-bezier(.3,1.6,.5,1) backwards, sc-vol 1.1s 2.7s cubic-bezier(.5,0,.8,.4) forwards; }
  .joue .balle-x { animation: sc-balle-x 2.6s var(--t) linear both; }
  .joue .balle-y { animation: sc-balle-y .43s var(--t) cubic-bezier(.3,.6,.6,1) 6 alternate both; }
  .joue .balle-r { animation: sc-tour-simple 1.3s var(--t) linear 2; }
  .joue .tampon { animation: sc-tampon .45s 1.3s cubic-bezier(.2,1.4,.4,1) forwards; }
  .joue .onde-tampon { animation: sc-ripple .8s 1.55s ease-out; }

  @keyframes sc-voile { 0% { opacity: 0; } 7% { opacity: 1; } 86% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes sc-trace { to { stroke-dashoffset: 0; } }
  @keyframes sc-pop { from { scale: 0; opacity: 0; } }
  @keyframes sc-fondu { from { opacity: 0; } }
  @keyframes sc-glisse { from { opacity: 0; transform: translateX(40px); } }
  @keyframes sc-monte { from { opacity: 0; translate: 0 8px; } }
  @keyframes sc-envol { 0% { opacity: 0; transform: translateY(0) scale(.6); } 20% { opacity: 1; } 100% { opacity: 0; transform: translateY(-120px) scale(1.1); } }
  @keyframes sc-pulse { 50% { scale: 1.14; } }
  @keyframes sc-tour { to { transform: rotate(360deg); } }
  @keyframes sc-tour-inverse { to { transform: rotate(-360deg); } }
  @keyframes sc-tour-simple { to { transform: rotate(360deg); } }
  @keyframes sc-tour-quart { to { transform: rotate(90deg); } }
  @keyframes sc-flash { 0% { opacity: 0; } 15% { opacity: .85; } 100% { opacity: 0; } }
  @keyframes sc-focus { 0% { opacity: 0; scale: 2.2; } 40% { opacity: 1; scale: 1; } 55% { opacity: .2; } 70% { opacity: 1; } 100% { opacity: 1; scale: 1; } }
  @keyframes sc-clignote { 50% { opacity: .15; } }
  @keyframes sc-onde { 0% { opacity: 0; } 25% { opacity: .95; } 100% { opacity: 0; } }
  @keyframes sc-ecrit { from { transform: translate(0, 0); } 20% { transform: translate(18px, -14px); } 40% { transform: translate(42px, -4px); } 60% { transform: translate(70px, -8px); } 80% { transform: translate(100px, -2px); } to { transform: translate(140px, -3px); } }
  @keyframes sc-vol { to { transform: translate(150px, -70px) rotate(18deg); opacity: 0; } }
  @keyframes sc-balle-x { from { transform: translateX(0); } to { transform: translateX(158px); } }
  @keyframes sc-balle-y { from { transform: translateY(0); } to { transform: translateY(-58px); } }
  @keyframes sc-tampon { 0% { opacity: 0; scale: 2.6; } 60% { opacity: 1; scale: .92; } 100% { opacity: 1; scale: 1; } }
  @keyframes sc-ripple { 0% { opacity: .9; scale: 1; } 100% { opacity: 0; scale: 2.4; } }

  .astuce { display: inline-flex; align-items: center; gap: .6em; margin: 0 0 1.1rem; font-family: var(--f-label); font-size: .78rem; letter-spacing: .18em; text-transform: uppercase; color: var(--bleu); }
  .astuce::before { content: ''; width: .6em; height: .6em; border-radius: 50%; background: var(--bleu); animation: sc-clignote 1.6s ease-in-out infinite; }

  @media (prefers-reduced-motion: reduce) {
    .joue .scene * { animation: none !important; }
    .scene-dessin .tr, .scene-lignes line { stroke-dashoffset: 0; }
    .scene-dessin .tampon, .scene-dessin .focus { opacity: 1; }
    .astuce::before { animation: none; }
  }
</style>

<script>
  import { chargerContenus, chargerBureau, remplir, texte, paragraphes } from '../lib/contenu';
  import { urlMedia as media } from '../lib/images';
  import { h as el } from '../lib/dom';
  import { sceneDuRole } from '../lib/roles';

  /** Photo cliquable : une petite scène animée, propre au rôle, se joue sur le portrait. */
  function photoAnimee(m: { nom: string; role: string; photo: string | null }, contenu: Element) {
    const NS = 'http://www.w3.org/2000/svg';
    const { cle, svg } = sceneDuRole(m.role);
    const lignes = document.createElementNS(NS, 'svg');
    lignes.setAttribute('viewBox', '0 0 100 125'); lignes.setAttribute('preserveAspectRatio', 'none'); lignes.setAttribute('class', 'scene-lignes');
    lignes.innerHTML = '<line x1="-5" y1="34" x2="40" y2="-5" pathLength="1"/><line x1="-5" y1="46" x2="54" y2="-5" pathLength="1"/><line x1="105" y1="92" x2="46" y2="130" pathLength="1"/><line x1="105" y1="104" x2="62" y2="130" pathLength="1"/>';
    const dessin = document.createElementNS(NS, 'svg');
    dessin.setAttribute('viewBox', '0 0 200 250'); dessin.setAttribute('class', `scene-dessin scene-${cle}`);
    dessin.innerHTML = svg;   // SVG fixe, défini dans lib/roles.ts
    const libelle = m.role.replace(/^resp(onsable|\.)\s*(de la |du |des |de l’|de )?/i, '');
    const scene = el('span', { class: 'scene', 'aria-hidden': 'true' }, lignes, dessin, el('span', { class: 'scene-role' }, libelle));
    const b = el('button', { type: 'button', class: 'photo-bouton', 'aria-label': `${m.nom}, ${m.role} : lancer l’animation` }, contenu, scene);
    b.addEventListener('click', () => {
      b.classList.remove('joue'); void b.offsetWidth; b.classList.add('joue');
      try { navigator.vibrate?.(12); } catch { /* sans vibration */ }
    });
    scene.addEventListener('animationend', (e) => { if (e.target === scene) b.classList.remove('joue'); });
    return b;
  }

  (async () => {
    const [{ club }, bureau] = await Promise.all([chargerContenus(), chargerBureau()]);
    const zone = (c: string) => document.querySelector(`[data-c="${c}"]`);
    if (club) {
      if (club.intro?.trim()) remplir(zone('intro')!, paragraphes(club.intro, 'chapo'));
      if (club.histoire?.trim()) remplir(zone('histoire')!, paragraphes(club.histoire));
      if (club.mission?.trim()) remplir(zone('mission')!, paragraphes(club.mission, 'chapo'));
      if (club.etapes?.length) remplir(zone('etapes')!, club.etapes.map((e) => el('li', {},
        el('span', { class: 'label quand' }, texte(e.quand)), el('p', { class: 'quoi' }, e.quoi), e.detail ? el('p', { class: 'detail' }, texte(e.detail)) : null)));
      if (club.valeurs?.length) remplir(zone('valeurs')!, club.valeurs.map((v, i) => el('li', {},
        el('span', { class: 'num', 'aria-hidden': 'true' }, String(i + 1).padStart(2, '0')), el('h3', { class: 'titre-3' }, v.titre), el('p', {}, v.texte))));
    }
    if (bureau.length) {
      const modele = document.querySelector('[data-c="bureau"] .emplacement');
      remplir(zone('bureau')!, bureau.map((m) => el('li', { class: 'membre' },
        photoAnimee(m, m.photo ? el('img', { src: media(m.photo), alt: `Portrait de ${m.nom}`, width: 480, height: 600, loading: 'lazy' })
          : (modele?.cloneNode(true) as Element) ?? el('div', { class: 'emplacement' })),
        el('div', { class: 'membre-texte' }, el('p', { class: 'nom' }, m.nom), el('p', { class: 'role label' }, m.role)))));
      // Indice + démonstration : la première carte joue une fois quand l'équipe arrive à l'écran.
      const liste = zone('bureau') as HTMLElement;
      if (!document.querySelector('.astuce')) liste.before(el('p', { class: 'astuce' }, 'Touchez une photo'));
      const premiere = liste.querySelector<HTMLButtonElement>('.photo-bouton');
      if (premiere && 'IntersectionObserver' in window) {
        const obs = new IntersectionObserver((vus) => {
          if (!vus.some((v) => v.isIntersecting)) return;
          obs.disconnect(); setTimeout(() => premiere.classList.add('joue'), 500);
        }, { threshold: .6 });
        obs.observe(premiere);
      }
    }
  })();
</script>

<script>
  import { sb } from '../lib/supabase';
  import { h, vider } from '../lib/dom';
  import { urlMedia } from '../lib/images';
  (async () => {
    const { data } = await sb.from('partenaires').select('*').order('ordre').order('created_at');
    if (!data?.length) return;
    document.getElementById('bloc-partenaires')!.hidden = false;
    vider(document.getElementById('liste-partenaires')!, data.map((p) => {
      const contenu = [
        p.logo ? h('img', { src: urlMedia(p.logo), alt: p.nom, loading: 'lazy' }) : h('strong', { class: 'nom' }, p.nom),
        p.logo ? h('span', { class: 'sr-only' }, p.nom) : null,
        p.description ? h('span', { class: 'desc' }, p.description) : null,
      ];
      return h('li', {}, p.site && /^https?:/.test(p.site)
        ? h('a', { href: p.site, target: '_blank', rel: 'noopener' }, ...contenu, h('span', { class: 'sr-only' }, ' (nouvel onglet)'))
        : h('div', {}, ...contenu));
    }));
  })();
</script>
<style>
  .partenaires { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 1rem; }
  .partenaires li > * { display: grid; gap: .5rem; justify-items: center; text-align: center; height: 100%; padding: 1.1rem; background: var(--blanc); border: 1px solid var(--bleu-12); border-radius: var(--rayon); text-decoration: none; color: var(--encre); }
  .partenaires a:hover { border-color: var(--bleu); }
  .partenaires img { max-height: 64px; width: auto; max-width: 100%; object-fit: contain; }
  .partenaires .nom { font-family: var(--f-label); font-weight: 600; text-transform: uppercase; color: var(--marine); }
  .partenaires .desc { font-size: .9rem; color: var(--encre-70); }
</style>
