---
import Base from '../../layouts/Base.astro';
import EnTetePage from '../../components/EnTetePage.astro';
import AppelRejoindre from '../../components/AppelRejoindre.astro';
---
<Base titre="Événements" description="L’agenda du Club 2AMECA : formations, ateliers, conférences et rencontres à la Faculté des Sciences Aïn Chock.">
  <EnTetePage surtitre="Agenda" titre="Événements" chapo="Formations, ateliers, conférences et rencontres : touchez un événement pour voir ses détails et ses photos." />

  <section class="section" aria-labelledby="a-venir">
    <div class="conteneur">
      <h2 id="a-venir" class="titre-2">À venir</h2>
      <hr class="trait" />
      <ul class="grille grille-2 liste-evt" role="list" id="liste-a-venir" data-e-ignore><li class="vide">Chargement…</li></ul>
    </div>
  </section>

  <section class="section teinte" aria-labelledby="passes">
    <div class="conteneur">
      <h2 id="passes" class="titre-2">Événements passés</h2>
      <hr class="trait" />
      <ul class="grille grille-2 liste-evt" role="list" id="liste-passes" data-e-ignore><li class="vide">Chargement…</li></ul>
    </div>
  </section>

  <AppelRejoindre />
</Base>

<style is:global>
  .liste-evt { list-style: none; padding: 0; }
  .liste-evt > li { display: grid; }
  .liste-evt .vide { color: var(--encre-70); font-size: 1.05rem; }
  .carte-evt {
    position: relative; display: grid; grid-template-columns: 5rem 1fr; gap: 1rem; align-items: start;
    background: var(--blanc); border: 1px solid var(--bleu-12); border-radius: var(--rayon); padding: 1rem; box-shadow: var(--ombre);
    transition: border-color .2s, transform .2s;
  }
  .carte-evt:hover { border-color: var(--bleu); transform: translateY(-2px); }
  .carte-evt:has(a:focus-visible) { outline: 3px solid var(--bleu); outline-offset: 3px; }
  @media (min-width: 640px) { .carte-evt { grid-template-columns: 6.5rem 1fr; gap: 1.3rem; padding: 1.2rem; } }
  .carte-evt.annulee { opacity: .7; }
  .ce-affiche { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 8px; background: var(--bleu-06); }
  .ce-date { text-align: center; border-radius: 10px; padding: .6rem .2rem .55rem; background: var(--bleu); color: var(--blanc); line-height: 1; }
  .ce-jour { display: block; font-family: var(--f-titre); font-size: 2.3rem; }
  .ce-mois { display: block; font-family: var(--f-label); text-transform: uppercase; letter-spacing: .14em; font-size: .78rem; margin-top: .3rem; color: var(--ciel); }
  .ce-annee { display: block; font-family: var(--f-label); font-size: .72rem; margin-top: .2rem; color: var(--blanc-70); }
  .ce-type { font-family: var(--f-label); font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; color: var(--bleu); }
  .ce-titre { font-family: var(--f-label); font-weight: 600; font-size: 1.2rem; line-height: 1.25; color: var(--marine); margin: .3rem 0 0; text-transform: uppercase; }
  .ce-titre a { color: inherit; text-decoration: none; }
  .ce-titre a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .ce-titre a:focus-visible { outline: none; }
  .ce-meta { display: flex; flex-wrap: wrap; gap: .1rem 1rem; margin: .45rem 0 .55rem; font-family: var(--f-label); font-size: .86rem; color: var(--bleu); }
  .ce-resume { margin: 0 0 .6rem; color: var(--encre-70); font-size: .98rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .ce-plus { font-family: var(--f-label); font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: var(--bleu); }
</style>

<script>
  import { chargerEvenements, carte, termine } from '../../lib/evenements';
  import { messageErreur } from '../../lib/supabase';
  import { h, vider } from '../../lib/dom';

  const avenir = document.getElementById('liste-a-venir')!, passes = document.getElementById('liste-passes')!;
  chargerEvenements().then((tous) => {
    const aVenir = tous.filter((e) => !termine(e)).reverse();   // le plus proche d'abord
    const fini = tous.filter((e) => termine(e));                 // le plus récent d'abord
    vider(avenir, aVenir.length ? aVenir.map((e) => h('li', {}, carte(e)))
      : h('li', { class: 'vide' }, 'Aucun événement annoncé pour le moment. Suivez-nous sur nos réseaux pour ne rien manquer.'));
    vider(passes, fini.length ? fini.map((e) => h('li', {}, carte(e))) : h('li', { class: 'vide' }, 'Les événements passés apparaîtront ici.'));
  }).catch((e) => { vider(avenir, h('li', { class: 'vide' }, messageErreur(e))); vider(passes); });
</script>
