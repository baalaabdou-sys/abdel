---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Lignes from '../../components/Lignes.astro';
import CompteARebours from '../../components/CompteARebours.astro';
import Emplacement from '../../components/Emplacement.astro';
import AppelRejoindre from '../../components/AppelRejoindre.astro';
import { getEvenements } from '../../lib/collections';
import { plageDates, plageJours, heureFr } from '../../lib/dates';
import { u } from '../../lib/url';
import { INSCRIPTION_PATH } from '../../config';

export async function getStaticPaths() {
  const evts = await getEvenements();
  return evts.map((e) => ({ params: { id: e.id }, props: { evenement: e } }));
}

const { evenement: e } = Astro.props;
const { Content } = await render(e);
const aVenir = e.fin.getTime() >= Date.now();
const inscription = e.data.inscription ?? u(INSCRIPTION_PATH);
const externe = /^https?:/.test(inscription);
---
<Base titre={e.data.titre} description={e.data.resume} image={e.data.affiche?.src} imageAlt={e.data.afficheAlt} type="article">
  <section class="tete sombre">
    <Lignes variante="haut-droite" />
    <div class="conteneur mise">
      <div class="infos">
        <a class="retour lien-fleche" href={u('/evenements/')}><span aria-hidden="true">←</span> Agenda</a>
        <span class="surtitre">
          {aVenir ? 'Événement à venir' : 'Événement passé'}
          {e.data.anneeUniversitaire && ` · ${e.data.anneeUniversitaire}`}
        </span>
        <h1 class="titre-1">{e.data.titre}</h1>
        <p class="dates">{plageDates(e.data.dateDebut, e.data.dateFin)}</p>
        <p class="heure"><span class="jours">{plageJours(e.data.dateDebut, e.data.dateFin)}</span>{e.data.heure && <>{' · '}à partir de {heureFr(e.data.heure)}</>}</p>

        {aVenir && (
          <div class="rebours-zone" data-a-venir>
            <CompteARebours debut={e.debut} fin={e.fin} />
            <div class="boutons">
              <a class="btn btn-clair" href={inscription} target={externe ? '_blank' : undefined} rel={externe ? 'noopener' : undefined}>S’inscrire <span class="fleche" aria-hidden="true">→</span></a>
              <a class="btn btn-contour" href={u(`/evenements/${e.id}.ics`)} download>Ajouter à mon agenda</a>
            </div>
          </div>
        )}
      </div>
      <div class="affiche">
        {e.data.affiche ? (
          <Image src={e.data.affiche} alt={e.data.afficheAlt ?? `Affiche : ${e.data.titre}`} widths={[400, 640, 900]} sizes="(min-width: 980px) 420px, 90vw" loading="eager" />
        ) : (
          <Emplacement texte="[Affiche de l’événement]" ratio="4 / 5" sombre />
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="conteneur">
      <div class="cartouche clair reveal">
        <div>
          <span class="label">Dates</span>
          <strong>{plageDates(e.data.dateDebut, e.data.dateFin)}</strong>
          {e.data.heure && <small>À partir de {heureFr(e.data.heure)}{e.data.heureFin && ` jusqu’à ${heureFr(e.data.heureFin)}`}</small>}
        </div>
        <div>
          <span class="label">Lieu</span>
          <strong>{e.data.lieu}</strong>
          {e.data.lieuDetail && <small>{e.data.lieuDetail}</small>}
        </div>
        {e.data.programme.length > 0 && (
          <div>
            <span class="label">Au programme</span>
            <strong>{e.data.programme.join(' · ')}</strong>
          </div>
        )}
      </div>

      {e.data.aVerifier && (
        <p class="verifier"><span class="a-fournir">[Informations reprises des publications du club — à vérifier et compléter.]</span></p>
      )}

      <div class="texte corps reveal"><Content /></div>

      <!-- Photos de l'événement (fichiers du site + album de la galerie) -->
      <div class="bloc-photos" id="bloc-photos" hidden={!e.data.photos.length && !e.data.affiche}>
        <h2 class="titre-3 titre-photos">En images</h2>
        <ul class="photos" id="photos" role="list" data-album={e.data.album ?? ''} data-sauf={e.id}>
          {[...(e.data.affiche ? [{ src: e.data.affiche, alt: e.data.afficheAlt ?? e.data.titre }] : []), ...e.data.photos].map((ph) => (
            <li>
              <button type="button" class="vignette" aria-label={`Agrandir : ${ph.alt}`}>
                <Image src={ph.src} alt={ph.alt} widths={[400, 800, 1400]} sizes="(min-width: 720px) 33vw, 50vw" />
              </button>
            </li>
          ))}
        </ul>
      </div>

      {aVenir && (
        <div class="boutons fin">
          <a class="btn" href={inscription} target={externe ? '_blank' : undefined} rel={externe ? 'noopener' : undefined}>S’inscrire <span class="fleche" aria-hidden="true">→</span></a>
          <a class="btn btn-contour" href={u('/contact/')}>Une question ?</a>
        </div>
      )}
    </div>
  </section>

  <dialog class="grande-photo" id="grande-photo" aria-label="Photo agrandie">
    <button type="button" class="gp-fermer" id="gp-fermer">Fermer</button>
    <button type="button" class="gp-nav gp-prec" id="gp-prec" aria-label="Photo précédente"><span aria-hidden="true">←</span></button>
    <img id="gp-img" alt="" />
    <button type="button" class="gp-nav gp-suiv" id="gp-suiv" aria-label="Photo suivante"><span aria-hidden="true">→</span></button>
    <p class="gp-compteur" id="gp-compteur" aria-live="polite"></p>
  </dialog>

  <AppelRejoindre />
</Base>

<script>
  import { sb } from '../../lib/supabase';
  import { urlMedia } from '../../lib/images';

  const liste = document.getElementById('photos') as HTMLUListElement | null;
  const bloc = document.getElementById('bloc-photos')!;
  const dlg = document.getElementById('grande-photo') as HTMLDialogElement;
  const img = document.getElementById('gp-img') as HTMLImageElement;
  let i = 0;
  const sources = () => [...(liste?.querySelectorAll('img') ?? [])].map((x) => ({ src: x.currentSrc || x.src, alt: x.alt, grand: x.dataset.grand }));
  function montrer(n: number) {
    const s = sources(); if (!s.length) return;
    i = (n + s.length) % s.length;
    const ph = s[i];
    // La plus grande version disponible de l'image
    const el = liste!.querySelectorAll('img')[i];
    const srcset = el.getAttribute('srcset');
    img.src = ph.grand ?? (srcset ? srcset.split(',').pop()!.trim().split(' ')[0] : ph.src);
    img.alt = ph.alt;
    document.getElementById('gp-compteur')!.textContent = `${i + 1} / ${s.length}`;
    const seule = s.length < 2;
    document.getElementById('gp-prec')!.hidden = seule; document.getElementById('gp-suiv')!.hidden = seule;
  }
  liste?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('.vignette'); if (!b) return;
    montrer([...liste.querySelectorAll('.vignette')].indexOf(b as HTMLButtonElement)); dlg.showModal();
  });
  document.getElementById('gp-prec')!.addEventListener('click', () => montrer(i - 1));
  document.getElementById('gp-suiv')!.addEventListener('click', () => montrer(i + 1));
  document.getElementById('gp-fermer')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') montrer(i + 1); if (e.key === 'ArrowLeft') montrer(i - 1); });
  let x0: number | null = null;
  dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  dlg.addEventListener('touchend', (e) => { if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; x0 = null; if (Math.abs(dx) > 40) montrer(dx < 0 ? i + 1 : i - 1); });

  // Album de la galerie : les photos ajoutées depuis le tableau de bord
  const album = liste?.dataset.album;
  if (album && liste) {
    sb.from('photos').select('chemin, legende, created_at').eq('legende', album).order('created_at').then(({ data }) => {
      // l'affiche, déjà affichée, est aussi dans l'album : on ne la répète pas
      const sauf = liste.dataset.sauf ?? '';
      const nouvelles = (data ?? []).filter((p) => !(sauf && p.chemin.endsWith(`${sauf}.jpg`)));
      for (const p of nouvelles) {
        const li = document.createElement('li');
        const b = document.createElement('button'); b.type = 'button'; b.className = 'vignette'; b.setAttribute('aria-label', 'Agrandir la photo');
        const im = document.createElement('img'); im.src = urlMedia(p.chemin); im.alt = album; im.loading = 'lazy'; im.dataset.grand = urlMedia(p.chemin);
        b.append(im); li.append(b); liste.append(li);
      }
      if (nouvelles.length) bloc.hidden = false;
    });
  }
</script>

<style>
  .bloc-photos { margin-top: clamp(2.5rem, 6vw, 4rem); }
  .titre-photos { color: var(--marine); margin-bottom: 1rem; }
  .photos { list-style: none; padding: 0; display: grid; gap: .6rem; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 720px) { .photos { grid-template-columns: repeat(3, 1fr); gap: .8rem; } }
  .photos :global(.vignette) { display: block; width: 100%; padding: 0; border: 0; border-radius: 10px; overflow: hidden; cursor: zoom-in; background: var(--bleu-06); }
  .photos :global(.vignette img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; transition: transform .35s; }
  .photos :global(.vignette:hover img) { transform: scale(1.04); }
  .grande-photo { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: var(--marine); color: var(--blanc); }
  .grande-photo[open] { display: grid; place-items: center; }
  .grande-photo::backdrop { background: var(--marine); }
  .grande-photo img { max-width: 94vw; max-height: 82dvh; object-fit: contain; border-radius: 6px; }
  .gp-fermer { position: absolute; top: 1rem; right: 1rem; min-height: 44px; padding: .3em 1.1em; border-radius: 999px; border: 1px solid var(--blanc-25); background: transparent; color: var(--blanc); font-family: var(--f-label); letter-spacing: .12em; text-transform: uppercase; cursor: pointer; }
  .gp-nav { position: absolute; top: 50%; translate: 0 -50%; width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--blanc-25); background: rgb(4 34 58 / .6); color: var(--blanc); font-size: 1.2rem; cursor: pointer; }
  .gp-prec { left: .75rem; } .gp-suiv { right: .75rem; }
  .gp-compteur { position: absolute; bottom: 1rem; left: 0; right: 0; text-align: center; margin: 0; font-family: var(--f-label); letter-spacing: .2em; color: var(--ciel); }
  .tete {
    position: relative; overflow: hidden;
    padding-block: clamp(2rem, 6vw, 4.5rem);
  }
  .tete > .conteneur { position: relative; z-index: 1; }
  .mise { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 980px) { .mise { grid-template-columns: minmax(0, 1fr) 420px; gap: 4rem; } }
  .retour { margin-bottom: 1.25rem; color: var(--ciel) !important; }
  .titre-1 { overflow-wrap: anywhere; hyphens: auto; }
  .dates { font-family: var(--f-titre); text-transform: uppercase; font-size: clamp(1.6rem, 6vw, 2.6rem); line-height: 1.05; margin: 1.25rem 0 .3rem; }
  .heure { font-family: var(--f-label); font-weight: 500; text-transform: uppercase; letter-spacing: .04em; font-size: 1.1rem; margin: 0; }
  .jours { color: var(--ciel); }
  .rebours-zone { margin-top: 2rem; display: grid; gap: 1.5rem; }
  .affiche { max-width: 420px; width: 100%; margin-inline: auto; }
  .affiche :global(img) { width: 100%; border-radius: 10px; box-shadow: 0 24px 50px -24px rgb(4 34 58 / .8); }
  .corps { margin-top: 2.5rem; }
  .verifier { margin-top: 1.5rem; }
  .fin { margin-top: 2rem; }
</style>
