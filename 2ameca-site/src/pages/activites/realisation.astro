---
import Base from '../../layouts/Base.astro';
import '../../styles/app.css';
import { u } from '../../lib/url';
---
<Base titre="Activité réalisée" description="Compte-rendu et photos d’une activité du Club 2AMECA.">
  <section class="app">
    <div class="conteneur">
      <a class="lien-fleche" href={u('/evenements/')}><span aria-hidden="true">←</span> Tous les événements</a>
      <p class="chargement" id="chargement">Chargement…</p>
      <article id="article" hidden>
        <span class="etiquette" id="type"></span>
        <h1 class="titre-1" id="titre" style="margin:.75rem 0 .5rem; color: var(--bleu)"></h1>
        <p class="aide" id="quand"></p>
        <hr class="trait" />
        <div class="texte" id="texte"></div>
        <ul class="galerie-pub" id="photos" role="list"></ul>
      </article>
    </div>
  </section>
</Base>

<style>
  .galerie-pub { list-style: none; padding: 0; margin-top: 2rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: .75rem; }
  .galerie-pub img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; display: block; }
  .galerie-pub figcaption { font-size: .9rem; color: var(--encre-70); padding-top: .3rem; }
  #texte p { white-space: pre-line; }
</style>

<script>
  import { sb, messageErreur, TYPES, type Formation } from '../../lib/supabase';
  import { h, vider, dateLongue } from '../../lib/dom';
  import { urlMedia } from '../../lib/images';

  const $ = (id: string) => document.getElementById(id)!;
  (async () => {
    const id = new URLSearchParams(location.search).get('id');
    if (!id) { $('chargement').textContent = 'Activité introuvable.'; return; }
    const [fRes, pRes] = await Promise.all([
      sb.from('formations').select('*').eq('id', id).maybeSingle(),
      sb.from('photos').select('*').eq('formation_id', id).order('created_at'),
    ]);
    const f = fRes.data as Formation | null;
    if (fRes.error || !f) { $('chargement').textContent = fRes.error ? messageErreur(fRes.error) : 'Activité introuvable.'; return; }
    document.title = `${f.titre} — Club 2AMECA`;
    $('type').textContent = TYPES[f.type];
    $('titre').textContent = f.titre;
    $('quand').textContent = `${dateLongue(f.date)}${f.lieu ? ` · ${f.lieu}` : ''}`;
    const texte = f.compte_rendu || f.description;
    vider($('texte'), texte ? h('p', {}, texte) : h('p', { class: 'aide' }, 'Compte-rendu à venir.'));
    vider($('photos'), (pRes.data ?? []).map((p) => h('li', {}, h('figure', { style: 'margin:0' },
      h('img', { src: urlMedia(p.chemin), alt: p.legende || f.titre, loading: 'lazy' }), p.legende ? h('figcaption', {}, p.legende) : null))));
    $('chargement').hidden = true; $('article').hidden = false;
  })();
</script>
