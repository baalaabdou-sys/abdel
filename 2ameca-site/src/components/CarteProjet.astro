---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Emplacement from './Emplacement.astro';
import { moisAnnee } from '../lib/dates';
import { u } from '../lib/url';

interface Props { projet: CollectionEntry<'projets'>; niveauTitre?: 'h2' | 'h3' }
const { projet: p, niveauTitre = 'h3' } = Astro.props;
const T = niveauTitre;
---
<article class="carte-projet reveal">
  <div class="visuel">
    {p.data.couverture ? (
      <Image src={p.data.couverture} alt={p.data.couvertureAlt ?? ''} widths={[400, 640, 800]} sizes="(min-width: 980px) 380px, (min-width: 640px) 50vw, 100vw" />
    ) : (
      <Emplacement texte="[Photo du projet]" ratio="4 / 3" />
    )}
  </div>
  <div class="corps">
    <p class="haut"><span class="etiquette">{p.data.type}</span><span class="label quand">{moisAnnee(p.data.date)}</span></p>
    <T class="titre-3"><a href={u(`/activites/${p.id}/`)}>{p.data.titre}</a></T>
    <p class="resume">{p.data.resume}</p>
    <p class="statut label">{p.data.statut}</p>
  </div>
</article>

<style>
  .carte-projet {
    position: relative; display: flex; flex-direction: column;
    background: var(--blanc); border: 1px solid var(--bleu-12); border-radius: var(--rayon);
    overflow: hidden; box-shadow: var(--ombre); transition: border-color .2s, transform .2s;
  }
  .carte-projet:hover { border-color: var(--bleu); transform: translateY(-2px); }
  .carte-projet:has(a:focus-visible) { outline: 3px solid var(--bleu); outline-offset: 3px; }
  .visuel { aspect-ratio: 4 / 3; overflow: hidden; background: var(--bleu-06); }
  .visuel :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .visuel :global(.emplacement) { border: 0; }
  .corps { padding: 1.2rem 1.25rem 1.3rem; display: flex; flex-direction: column; flex: 1; }
  .haut { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: .8rem; }
  .quand { color: var(--encre-70); font-size: .72rem; }
  .titre-3 { color: var(--marine); font-size: 1.3rem; margin-bottom: .5rem; }
  .titre-3 a { color: inherit; text-decoration: none; }
  .titre-3 a::after { content: ''; position: absolute; inset: 0; }
  .titre-3 a:focus-visible { outline: none; }
  .resume { color: var(--encre-70); font-size: 1rem; margin-bottom: 1rem; }
  .statut { margin: auto 0 0; color: var(--bleu); font-size: .72rem; padding-top: .8rem; border-top: 1px solid var(--bleu-12); }
</style>
