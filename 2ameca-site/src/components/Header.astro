---
import { u, estActif } from '../lib/url';

const liens = [
  { href: '/', label: 'Accueil' },
  { href: '/le-club/', label: 'Le club' },
  { href: '/evenements/', label: 'Événements' },
];
const chemin = Astro.url.pathname;
---
<header class="entete">
  <div class="conteneur barre">
    <a class="marques" href={u('/')} aria-label="Club 2AMECA — accueil">
      <img class="logo-club" src={u('/logos/2ameca-white-560.png')} width="560" height="120" alt="" />
    </a>

    <div class="cloche-zone" id="cloche-zone" hidden>
      <button type="button" class="cloche" id="cloche" aria-expanded="false" aria-controls="cloche-panneau" aria-label="Notifications">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 20.5a2 2 0 0 0 4 0"/></svg>
        <span class="cloche-nb" id="cloche-nb" hidden></span>
      </button>
      <div class="cloche-panneau" id="cloche-panneau" hidden>
        <div class="cp-tete"><strong>Notifications</strong><button type="button" class="cp-fermer" id="cp-fermer" aria-label="Fermer">×</button></div>
        <ul class="cp-liste" id="cp-liste" role="list"><li class="cp-vide">Chargement…</li></ul>
        <a class="cp-tout" id="cp-tout" href="#">Tout voir dans Mon espace →</a>
      </div>
    </div>

    <nav class="nav" aria-label="Navigation principale">
      <button class="bouton-menu" type="button" aria-expanded="false" aria-controls="menu-principal">
        <span class="bouton-menu-texte">Menu</span>
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>

      <div class="panneau" id="menu-principal">
        <ul class="liens" role="list">
          {liens.map(({ href, label }) => (
            <li>
              <a href={u(href)} aria-current={estActif(chemin, href) ? 'page' : undefined}>{label}</a>
            </li>
          ))}
        </ul>
        <a class="btn btn-clair rejoindre" id="bouton-compte" href={u('/rejoindre/')} aria-current={estActif(chemin, '/rejoindre/') ? 'page' : undefined}>
          Rejoindre
        </a>
        <a class="lien-connexion" id="lien-connexion" href={u('/connexion/')}>Connexion</a>
        <p class="panneau-pied label" aria-hidden="true">Esprit citoyen au centre</p>
      </div>
    </nav>
  </div>
</header>

<style>
  .entete {
    position: sticky; top: 0; z-index: 50;
    background: var(--marine); color: var(--blanc);
    border-bottom: 1px solid var(--ciel-18);
  }
  .barre { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: var(--header-h); }

  .marques { display: flex; align-items: center; gap: 12px; text-decoration: none; flex-shrink: 0; }
  .separateur { width: 1px; height: 30px; background: var(--blanc-25); }
  .logo-club { width: 112px; height: auto; }
  @media (min-width: 720px) { .logo-club { width: 148px; } .separateur { height: 38px; } .marques { gap: 16px; } }

  .bouton-menu {
    display: inline-flex; align-items: center; gap: .7rem;
    min-height: 44px; padding: 0 .9rem; margin-right: -.4rem;
    background: transparent; color: var(--blanc); border: 1px solid var(--blanc-25); border-radius: 999px;
    font-family: var(--f-label); font-size: .85rem; letter-spacing: .14em; text-transform: uppercase; cursor: pointer;
    position: relative; z-index: 2;
  }
  .burger { display: grid; gap: 5px; width: 18px; }
  .burger span { display: block; height: 1.5px; background: currentColor; transition: transform .25s; }
  [aria-expanded='true'] .burger span:first-child { transform: translateY(3.25px) rotate(45deg); }
  [aria-expanded='true'] .burger span:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  /* Mobile : panneau plein écran */
  .panneau {
    position: fixed; inset: var(--header-h) 0 0 0;
    background: var(--marine);
    padding: 2rem var(--gouttiere) 2.5rem;
    display: flex; flex-direction: column; gap: 2rem;
    overflow-y: auto;
    visibility: hidden; opacity: 0; transform: translateY(-8px);
    transition: opacity .2s, transform .2s, visibility 0s .2s;
  }
  .nav.ouvert .panneau { visibility: visible; opacity: 1; transform: none; transition: opacity .2s, transform .2s; }
  .liens { list-style: none; padding: 0; display: grid; }
  .liens a {
    display: block; padding: .55rem 0;
    font-family: var(--f-titre); font-size: clamp(2.2rem, 11vw, 3rem); line-height: 1.05;
    text-transform: uppercase; color: var(--blanc); text-decoration: none;
    border-bottom: 1px solid var(--ciel-18);
  }
  .liens a[aria-current='page'] { color: var(--ciel); }
  .rejoindre { align-self: flex-start; }
  .lien-connexion { color: var(--blanc); font-family: var(--f-label); text-transform: uppercase; letter-spacing: .14em; font-size: .9rem; text-decoration: none; align-self: flex-start; padding: .5rem 0; }
  .lien-connexion:hover { text-decoration: underline; }
  button.lien-connexion { background: none; border: 0; cursor: pointer; min-height: 44px; }
  .panneau-pied { margin-top: auto; color: var(--ciel); }

  /* Sans JavaScript : liens toujours visibles sous la barre */
  @media (max-width: 1039px) {
    :global(html:not(.js)) .bouton-menu { display: none; }
    :global(html:not(.js)) .barre { flex-wrap: wrap; height: auto; padding-block: 12px; }
    :global(html:not(.js)) .panneau {
      position: static; visibility: visible; opacity: 1; transform: none; padding: 0; gap: 1rem;
    }
    :global(html:not(.js)) .liens { display: flex; flex-wrap: wrap; gap: 0 1rem; }
    :global(html:not(.js)) .liens a { font-family: var(--f-label); font-size: 1rem; border: 0; }
    :global(html:not(.js)) .panneau-pied { display: none; }
  }

  @media (min-width: 1040px) {
    .bouton-menu { display: none; }
    .panneau {
      position: static; inset: auto; padding: 0; background: none; overflow: visible;
      flex-direction: row; align-items: center; gap: 2rem;
      visibility: visible; opacity: 1; transform: none; transition: none;
    }
    .liens { display: flex; gap: 1.75rem; }
    .liens a {
      font-family: var(--f-label); font-size: .9rem; letter-spacing: .14em; font-weight: 500;
      padding: .5rem 0; border: 0; position: relative;
    }
    .liens a::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
      background: var(--ciel); transform: scaleX(0); transform-origin: left; transition: transform .2s;
    }
    .liens a:hover::after, .liens a[aria-current='page']::after { transform: scaleX(1); }
    .liens a[aria-current='page'] { color: var(--blanc); }
    .rejoindre { min-height: 42px; padding: .5em 1.3em; font-size: .85rem; }
    .lien-connexion { font-size: .85rem; align-self: center; }
    .liens { gap: 1.4rem; }
    .panneau-pied { display: none; }
  }
</style>

<style is:global>
  /* Cloche des notifications (membres connectés) */
  .cloche-zone { position: relative; margin-left: auto; z-index: 3; }
  .cloche-zone[hidden] { display: none; }
  .cloche { position: relative; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--blanc-25); background: transparent; color: var(--blanc); cursor: pointer; transition: background .2s, color .2s; }
  .cloche svg { width: 21px; height: 21px; }
  .cloche:hover, .cloche[aria-expanded='true'] { background: var(--blanc); color: var(--marine); }
  .cloche:focus-visible { outline: 3px solid var(--ciel); outline-offset: 2px; }
  .cloche-nb { position: absolute; top: -3px; right: -3px; min-width: 19px; height: 19px; padding: 0 5px; border-radius: 999px; background: var(--ciel); color: var(--marine); font: 600 11px/19px var(--f-texte); text-align: center; box-shadow: 0 0 0 2px var(--marine); }
  .cloche-nb[hidden] { display: none; }
  .cloche.vibre svg { animation: cl-vibre .9s ease 2; transform-origin: 50% 15%; }
  @keyframes cl-vibre { 0%, 100% { transform: rotate(0); } 15% { transform: rotate(14deg); } 30% { transform: rotate(-12deg); } 45% { transform: rotate(8deg); } 60% { transform: rotate(-5deg); } }
  .cloche-panneau {
    position: absolute; right: 0; top: calc(100% + 10px); width: min(360px, calc(100vw - 2 * var(--gouttiere)));
    background: var(--blanc); color: var(--encre); border-radius: var(--rayon); box-shadow: 0 18px 50px -14px rgb(4 34 58 / .55); overflow: hidden;
  }
  .cloche-panneau[hidden] { display: none; }
  .cp-tete { display: flex; align-items: center; justify-content: space-between; padding: .8rem 1rem; border-bottom: 1px solid var(--bleu-12); }
  .cp-tete strong { font-family: var(--f-label); letter-spacing: .14em; text-transform: uppercase; color: var(--marine); font-size: .85rem; }
  .cp-fermer { width: 34px; height: 34px; border: 0; background: none; font-size: 1.5rem; line-height: 1; color: var(--encre-70); cursor: pointer; border-radius: 50%; }
  .cp-fermer:hover { background: var(--bleu-06); }
  .cp-liste { list-style: none; margin: 0; padding: 0; max-height: min(60vh, 420px); overflow-y: auto; }
  .cp-liste li { border-bottom: 1px solid var(--bleu-12); }
  .cp-ligne { position: relative; overflow: hidden; background: var(--marine); }
  .cp-fond { position: absolute; inset: 0; display: flex; align-items: center; justify-content: flex-end; gap: .5rem; padding: 0 1.2rem; color: var(--ciel); font-family: var(--f-label); letter-spacing: .12em; text-transform: uppercase; font-size: .78rem; transition: color .15s; }
  .cp-fond svg { width: 20px; height: 20px; }
  .cp-fond.pret { color: var(--blanc); }
  .cp-liste a, .cp-liste .cp-item { position: relative; display: grid; gap: .2rem; padding: .75rem 2.6rem .75rem 1rem; text-decoration: none; color: inherit; background: var(--blanc); transition: transform .22s ease, opacity .22s ease; user-select: none; -webkit-user-drag: none; }
  .cp-liste a:hover { background: #f4f8fb; }
  .cp-liste .non-lue { background: #eaf4fc; }
  .cp-liste a.non-lue:hover { background: #e1eff9; }
  .cp-suppr { position: absolute; top: .55rem; right: .45rem; width: 32px; height: 32px; display: grid; place-items: center; border: 0; border-radius: 50%; background: transparent; color: var(--encre-70); cursor: pointer; opacity: .55; z-index: 1; transition: opacity .15s, background .15s; }
  .cp-suppr svg { width: 16px; height: 16px; }
  .cp-ligne:hover .cp-suppr, .cp-suppr:focus-visible { opacity: 1; }
  .cp-suppr:hover { background: var(--bleu-06); color: var(--marine); }
  .cp-ligne.glisse .cp-suppr, .cp-ligne.part .cp-suppr { opacity: 0; }
  .cp-annule { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .65rem 1rem; background: var(--marine); color: var(--blanc); font-size: .9rem; }
  .cp-annule[hidden] { display: none; }
  .cp-annule button { border: 0; background: none; color: var(--ciel); font-family: var(--f-label); letter-spacing: .12em; text-transform: uppercase; font-size: .8rem; cursor: pointer; min-height: 36px; }
  .cp-liste .non-lue strong::before { content: ''; display: inline-block; width: .5em; height: .5em; border-radius: 50%; background: var(--bleu); margin-right: .45em; vertical-align: middle; }
  .cp-liste strong { font-family: var(--f-label); font-weight: 500; color: var(--marine); line-height: 1.3; }
  .cp-liste .cp-msg { font-size: .88rem; color: var(--encre-70); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cp-liste time { font-size: .75rem; color: var(--encre-70); }
  .cp-vide { padding: 1.2rem 1rem; color: var(--encre-70); font-size: .92rem; }
  .cp-tout { display: block; padding: .8rem 1rem; text-align: center; font-family: var(--f-label); letter-spacing: .1em; text-transform: uppercase; font-size: .8rem; color: var(--bleu); text-decoration: none; background: var(--bleu-06); }
  .cp-tout:hover { background: var(--ciel); color: var(--marine); }
  @media (max-width: 1039px) {
    .cloche-zone { margin-right: .5rem; }
    .cloche-panneau { position: fixed; left: var(--gouttiere); right: var(--gouttiere); top: calc(var(--header-h) + 8px); width: auto; }
  }
  @media (min-width: 1040px) { .cloche-zone { order: 3; margin-left: 1rem; } .barre .nav { margin-left: auto; } }
  @media (prefers-reduced-motion: reduce) { .cloche.vibre svg { animation: none; } }

  /* Bouton de déconnexion (ajouté par le script quand on est connecté) */
  .deconnexion {
    display: inline-flex; align-items: center; justify-content: center; gap: .55em; align-self: flex-start;
    min-height: 44px; padding: 0 1.1em; border-radius: 999px; cursor: pointer;
    background: transparent; color: var(--blanc); border: 1px solid var(--blanc-25);
    font-family: var(--f-label); font-size: .85rem; letter-spacing: .14em; text-transform: uppercase;
    transition: background .2s, border-color .2s, color .2s;
  }
  .deconnexion svg { width: 18px; height: 18px; flex-shrink: 0; }
  .deconnexion:hover { background: var(--blanc); color: var(--marine); border-color: var(--blanc); }
  .deconnexion:focus-visible { outline: 3px solid var(--ciel); outline-offset: 2px; }
  .deconnexion:disabled { opacity: .6; cursor: default; }
  /* Sur ordinateur : un simple cercle avec l'icône, à côté de « Mon espace » */
  @media (min-width: 1040px) {
    .deconnexion { width: 42px; min-height: 42px; padding: 0; align-self: center; margin-left: -1.2rem; }
    .deconnexion span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.nav');
  const bouton = nav?.querySelector<HTMLButtonElement>('.bouton-menu');
  const panneau = document.getElementById('menu-principal');
  if (nav && bouton && panneau) {
    const mobile = window.matchMedia('(max-width: 1039px)');
    const syncInert = () => {
      const ferme = !nav.classList.contains('ouvert');
      panneau.toggleAttribute('inert', mobile.matches && ferme);
    };
    const basculer = (ouvrir: boolean) => {
      nav.classList.toggle('ouvert', ouvrir);
      bouton.setAttribute('aria-expanded', String(ouvrir));
      bouton.querySelector('.bouton-menu-texte')!.textContent = ouvrir ? 'Fermer' : 'Menu';
      document.body.style.overflow = ouvrir ? 'hidden' : '';
      syncInert();
    };
    bouton.addEventListener('click', () => basculer(!nav.classList.contains('ouvert')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('ouvert')) { basculer(false); bouton.focus(); }
    });
    panneau.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) basculer(false);
    });
    mobile.addEventListener('change', () => { if (!mobile.matches) basculer(false); syncInert(); });
    syncInert();
  }

  // Membre connecté : le bouton mène à son espace (session gardée par Supabase dans le navigateur).
  try {
    const cle = Object.keys(localStorage).find((k) => /^sb-.*-auth-token$/.test(k));
    if (cle && localStorage.getItem(cle)) {
      const b = document.getElementById('bouton-compte') as HTMLAnchorElement | null;
      const l = document.getElementById('lien-connexion');
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');
      if (b) { b.href = `${base}/espace/`; b.textContent = 'Mon espace'; b.removeAttribute('aria-current'); }
      // « Connexion » devient « Déconnexion »
      if (l) {
        const bouton = document.createElement('button');
        bouton.type = 'button'; bouton.className = 'deconnexion'; bouton.id = 'bouton-deconnexion';
        bouton.setAttribute('aria-label', 'Se déconnecter'); bouton.title = 'Se déconnecter';
        bouton.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4"/><path d="M15 16l4-4-4-4M19 12H9"/></svg><span>Déconnexion</span>';
        bouton.addEventListener('click', async () => {
          bouton.disabled = true; bouton.querySelector('span')!.textContent = 'Déconnexion…';
          try { const { sb } = await import('../lib/supabase'); await sb.auth.signOut(); }
          finally { try { localStorage.removeItem(cle); } catch { /* ignore */ } location.href = `${base}/`; }
        });
        l.replaceWith(bouton);
      }
      cloche(base);
    }
  } catch { /* stockage indisponible : on garde « Rejoindre » */ }

  /** Cloche : dernières notifications du membre, à portée de main sur toutes les pages. */
  async function cloche(base: string) {
    const zone = document.getElementById('cloche-zone')!, btn = document.getElementById('cloche') as HTMLButtonElement;
    const panneau = document.getElementById('cloche-panneau')!, liste = document.getElementById('cp-liste')!, nb = document.getElementById('cloche-nb')!;
    if (location.pathname.startsWith(`${base}/bureau/scanner`)) return;
    (document.getElementById('cp-tout') as HTMLAnchorElement).href = `${base}/espace/#notifications`;
    zone.hidden = false;
    const { sb } = await import('../lib/supabase');
    const { data: u } = await sb.auth.getUser();
    if (!u.user) { zone.hidden = true; return; }
    const moi = u.user.id;
    const depuis = new Date(Date.now() - 60 * 864e5).toISOString();
    const [nRes, lRes, mRes] = await Promise.all([
      sb.from('notifications').select('id, titre, message, lien, created_at').or(`membre_id.is.null,membre_id.eq.${moi}`).gte('created_at', depuis).order('created_at', { ascending: false }).limit(30),
      sb.from('notifications_lues').select('notification_id'),
      sb.from('notifications_masquees').select('notification_id'),
    ]);
    const masquees = new Set((mRes.data ?? []).map((m) => m.notification_id));
    const notifs = ((nRes.data ?? []) as { id: string; titre: string; message: string; lien: string | null; created_at: string }[])
      .filter((n) => !masquees.has(n.id)).slice(0, 8);
    const lues = new Set((lRes.data ?? []).map((l) => l.notification_id));
    let nonLues = notifs.filter((n) => !lues.has(n.id)).map((n) => n.id);
    const majNb = () => { nb.hidden = !nonLues.length; nb.textContent = nonLues.length > 9 ? '9+' : String(nonLues.length); btn.setAttribute('aria-label', nonLues.length ? `Notifications, ${nonLues.length} non lue(s)` : 'Notifications'); };
    majNb();
    if (nonLues.length) btn.classList.add('vibre');
    const quand = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Casablanca' });
    const vide = () => Object.assign(document.createElement('li'), { className: 'cp-vide', textContent: 'Aucune notification pour le moment.' });
    const annule = document.createElement('div'); annule.className = 'cp-annule'; annule.hidden = true;
    annule.innerHTML = '<span>Notification supprimée</span>';
    const bAnnule = document.createElement('button'); bAnnule.type = 'button'; bAnnule.textContent = 'Annuler'; annule.append(bAnnule);
    panneau.insertBefore(annule, document.getElementById('cp-tout'));
    let enAttente: { id: string; li: HTMLLIElement; apres: Element | null; minuteur: number } | null = null;

    /** Supprime (masque) une notification pour ce membre, avec 4 s pour annuler. */
    function supprimer(id: string, li: HTMLLIElement) {
      if (enAttente) valider();
      const apres = li.nextElementSibling;
      li.remove();
      if (!liste.querySelector('.cp-ligne')) liste.append(vide());
      nonLues = nonLues.filter((x) => x !== id); majNb();
      annule.hidden = false;
      enAttente = { id, li, apres, minuteur: window.setTimeout(valider, 4000) };
    }
    async function valider() {
      if (!enAttente) return;
      const { id, li, apres } = enAttente; clearTimeout(enAttente.minuteur); enAttente = null; annule.hidden = true;
      const { error } = await sb.from('notifications_masquees').upsert({ notification_id: id, membre_id: moi }, { ignoreDuplicates: true });
      if (error) { liste.querySelector('.cp-vide')?.remove(); liste.insertBefore(li, apres && apres.isConnected ? apres : null); remettre(li); }
    }
    function remettre(li: HTMLLIElement) { const c = li.querySelector<HTMLElement>('.cp-item'); if (c) { c.style.transform = ''; c.style.opacity = ''; } li.classList.remove('part'); }
    bAnnule.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!enAttente) return;
      const { li, apres } = enAttente; clearTimeout(enAttente.minuteur); enAttente = null; annule.hidden = true;
      liste.querySelector('.cp-vide')?.remove();
      liste.insertBefore(li, apres && apres.isConnected ? apres : null); remettre(li);
    });

    function ligne(n: (typeof notifs)[number]) {
      const li = document.createElement('li'); li.className = 'cp-ligne';
      const fond = document.createElement('span'); fond.className = 'cp-fond'; fond.setAttribute('aria-hidden', 'true');
      fond.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V4.5h6V7M6.5 7l1 13h9l1-13M10 11v5.5M14 11v5.5"/></svg>Supprimer';
      const el: HTMLElement = document.createElement(n.lien ? 'a' : 'div');
      el.className = `cp-item${lues.has(n.id) ? '' : ' non-lue'}`;
      if (n.lien) (el as HTMLAnchorElement).href = base + n.lien;
      const t = document.createElement('strong'); t.textContent = n.titre;
      const m = document.createElement('span'); m.className = 'cp-msg'; m.textContent = n.message ?? '';
      const d = document.createElement('time'); d.dateTime = n.created_at; d.textContent = quand.format(new Date(n.created_at));
      el.append(t, m, d);
      const x = document.createElement('button'); x.type = 'button'; x.className = 'cp-suppr'; x.setAttribute('aria-label', `Supprimer : ${n.titre}`);
      x.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 7l10 10M17 7L7 17"/></svg>';
      x.addEventListener('click', (e) => { e.stopPropagation(); e.preventDefault(); partir(-1); });
      li.append(fond, el, x);

      // Glisser du doigt (ou de la souris) vers la gauche ou la droite pour supprimer
      let x0 = 0, y0 = 0, dx = 0, actif = false, horizontal: boolean | null = null, deplace = false;
      const partir = (sens: number) => {
        li.classList.add('part');
        el.style.transform = `translateX(${sens * 110}%)`; el.style.opacity = '0';
        setTimeout(() => supprimer(n.id, li), 220);
      };
      el.addEventListener('pointerdown', (e) => { if (e.button) return; actif = true; horizontal = null; deplace = false; x0 = e.clientX; y0 = e.clientY; dx = 0; });
      el.addEventListener('pointermove', (e) => {
        if (!actif) return;
        const mx = e.clientX - x0, my = e.clientY - y0;
        if (horizontal === null && Math.hypot(mx, my) > 8) { horizontal = Math.abs(mx) > Math.abs(my); if (horizontal) el.setPointerCapture(e.pointerId); }
        if (!horizontal) return;
        deplace = true; dx = mx;
        li.classList.toggle('glisse', true);
        el.style.transition = 'none'; el.style.transform = `translateX(${dx}px)`;
        fond.style.justifyContent = dx < 0 ? 'flex-end' : 'flex-start';
        fond.classList.toggle('pret', Math.abs(dx) > el.offsetWidth * .35);
      });
      const fin = () => {
        if (!actif) return; actif = false;
        el.style.transition = '';
        li.classList.remove('glisse');
        if (horizontal && Math.abs(dx) > el.offsetWidth * .35) partir(Math.sign(dx));
        else { el.style.transform = ''; fond.classList.remove('pret'); }
      };
      el.addEventListener('pointerup', fin); el.addEventListener('pointercancel', fin);
      el.addEventListener('click', (e) => { if (deplace) { e.preventDefault(); deplace = false; } });
      el.style.touchAction = 'pan-y';
      return li;
    }
    liste.replaceChildren(...(notifs.length ? notifs.map(ligne) : [vide()]));
    const fermer = () => { panneau.hidden = true; btn.setAttribute('aria-expanded', 'false'); };
    btn.addEventListener('click', async () => {
      const ouvrir = panneau.hidden;
      panneau.hidden = !ouvrir; btn.setAttribute('aria-expanded', String(ouvrir)); btn.classList.remove('vibre');
      if (ouvrir && nonLues.length) {
        const ids = nonLues; nonLues = []; majNb();
        await sb.from('notifications_lues').upsert(ids.map((id) => ({ notification_id: id, membre_id: moi })), { ignoreDuplicates: true });
      }
    });
    document.getElementById('cp-fermer')!.addEventListener('click', fermer);
    document.addEventListener('click', (e) => { if (!zone.contains(e.target as Node)) fermer(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panneau.hidden) { fermer(); btn.focus(); } });
  }
</script>
